+pub fn compactConvStateEnabled() bool {
+    if (compact_conv_state_cached) |enabled| return enabled;
+    const enabled = if (std.c.getenv("MLX_SERVE_COMPACT_CONV_STATE")) |raw|
+        std.mem.eql(u8, std.mem.span(raw), "1")
+    else
+        false;
+    compact_conv_state_cached = enabled;
+    return enabled;
+}
