+fn evalCompactConvStates(s: mlx.mlx_stream, h: mlx.mlx_array, entries: []SSMCacheEntry) !void {
+    const arrays = mlx.mlx_vector_array_new();
+    defer _ = mlx.mlx_vector_array_free(arrays);
+    try mlx.check(mlx.mlx_vector_array_append_value(arrays, h));
+    for (entries) |*entry| {
+        if (entry.conv_state.ctx == null or mlx.mlx_array_size(entry.conv_state) == 0) continue;
+        // A short contiguous slice still owns the full prefill allocation.
+        // Evaluate an owned tail at the existing layer checkpoint.
+        const owned = try materializedOwnedCopy(s, entry.conv_state);
+        _ = mlx.mlx_array_free(entry.conv_state);
+        entry.conv_state = owned;
+        try mlx.check(mlx.mlx_vector_array_append_value(arrays, owned));
+    }
+    try mlx.check(mlx.mlx_eval(arrays));
+    if (!compact_conv_state_logged) {
+        log.info("[conv-state] compact prefill tails engaged: window={d}\n", .{entries.len});
+        compact_conv_state_logged = true;
+    }
+}
