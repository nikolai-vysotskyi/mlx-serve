+// A partial final window can keep full buffers alive into the next chunk.
+fn prefillStreamBytesAtWidth(config: *const model_mod.ModelConfig, width: u64, compact: bool) u64 {
+    const full = prefillStreamBytesPerToken(config);
+    if (!compact or !config.longCtxGated() or config.num_hidden_layers % MOE_PREFILL_COEXIST != 0 or
+        !transformer_mod.Transformer.prefillEvalCadenceApplies(@intCast(@min(width, 1 << 20)))) return full;
+    const linear_layers: u64 = @as(u64, config.num_hidden_layers) -| config.attnCacheLayerCount();
+    if (config.linear_num_value_heads == 0 or linear_layers <= MOE_PREFILL_COEXIST) return full;
+    const qkv: u64 = 2 * @as(u64, config.linear_num_key_heads) * config.linear_key_head_dim +
+        @as(u64, config.linear_num_value_heads) * config.linear_value_head_dim;
+    return full - (linear_layers - MOE_PREFILL_COEXIST) * qkv * 2;
+}
