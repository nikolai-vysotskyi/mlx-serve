diff --git a/src/ple_gpu_bridge.cpp b/src/ple_gpu_bridge.cpp
new file mode 100644
--- /dev/null
+++ b/src/ple_gpu_bridge.cpp
@@ -0,0 +1,48 @@
+// Experimental zero-copy PLE prefill. Native CPU path remains the fallback.
+#include <mlx/mlx.h>
+#include <mlx/allocator.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <cstring>
+#include <cstdio>
+#include <memory>
+namespace mx=mlx::core;
+namespace {
+struct State {
+  mx::array table, layout;
+  mx::fast::CustomKernelFunction kernel;
+  State(mx::array t,const uint64_t* p,const char* source):table(std::move(t)),layout(p,{7},mx::uint64),
+    kernel(mx::fast::metal_kernel("ple_mmap_affine4_bf16",{"table","rows","layout"},{"out"},source)){}
+};
+mx::array wrap(int fd,size_t bytes) {
+  size_t page=sysconf(_SC_PAGESIZE),length=(bytes+page-1)/page*page;
+  const size_t reserve=size_t(2)<<30;
+  if(mx::get_active_memory()+length+reserve>mx::get_memory_limit())
+    throw std::runtime_error("insufficient MLX memory budget for PLE table plus 2 GiB scratch");
+  void* p=mmap(nullptr,length,PROT_READ,MAP_PRIVATE,fd,0);
+  if(p==MAP_FAILED)throw std::runtime_error("PLE GPU mmap failed");
+  auto mapping=std::shared_ptr<void>(p,[length](void* q){munmap(q,length);});
+  auto buf=mx::allocator::make_buffer(p,length);
+  if(!buf.ptr())throw std::runtime_error("PLE mapping cannot be wrapped without a copy");
+  try {
+    return mx::array(buf,{int(length/page),int(page)},mx::uint8,
+      [mapping](mx::allocator::Buffer b){mx::allocator::release(b);});
+  }catch(...){mx::allocator::release(buf);throw;}
+}
+}
+extern "C" void* msv_ple_gpu_create(int fd,size_t bytes,const uint64_t* params,const char* source) {
+  try{return new State(wrap(fd,bytes),params,source);}
+  catch(const std::exception& e){std::fprintf(stderr,"[ple-gpu] unavailable: %s\n",e.what());return nullptr;}
+}
+extern "C" void msv_ple_gpu_destroy(void* p){delete static_cast<State*>(p);}
+extern "C" int msv_ple_gpu_gather(void* ptr,const int64_t* ids,size_t n,uint16_t* out) {
+  try {
+    auto& s=*static_cast<State*>(ptr);
+    auto rows=mx::array(ids,{int(n)},mx::int64);
+    auto y=s.kernel({s.table,rows,s.layout},{{int(n),160}},{mx::bfloat16},
+      {int(n*160),1,1},{256,1,1},{},{},false,mx::Device::gpu)[0];
+    mx::eval(y);
+    std::memcpy(out,y.data<mx::bfloat16_t>(),n*160*2);
+    return 0;
+  }catch(const std::exception& e){std::fprintf(stderr,"[ple-gpu] gather failed: %s\n",e.what());return 1;}
+}
diff --git a/src/kernels/ple_gpu.metal b/src/kernels/ple_gpu.metal
new file mode 100644
--- /dev/null
+++ b/src/kernels/ple_gpu.metal
@@ -0,0 +1,14 @@
+const uint i=thread_position_in_grid.x;
+const uint dim=160;
+if(ulong(i)>=ulong(rows_shape[0])*dim)return;
+const ulong row=ulong(rows[i/dim]);
+const uint c=i%dim,g=c/32;
+const device uint* w=reinterpret_cast<const device uint*>(table+layout[0]);
+const device ushort* s=reinterpret_cast<const device ushort*>(table+layout[1]);
+const device ushort* b=reinterpret_cast<const device ushort*>(table+layout[2]);
+uint q=(w[row*20+c/8]>>(4*(c%8)))&15u;
+float sc=as_type<float>(uint(s[row*5+g])<<16);
+float bi=as_type<float>(uint(b[row*5+g])<<16);
+uint bits=as_type<uint>(float(q)*sc+bi);
+// Match the host's explicit BF16 round-to-nearest-even conversion.
+out[i]=as_type<bfloat>(ushort((bits+0x7fffu+((bits>>16)&1u))>>16));
